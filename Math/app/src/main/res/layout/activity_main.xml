<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <!-- Título de la aplicación -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Math Operations"
        android:textSize="24sp"
        android:textColor="@android:color/black"
        android:layout_marginBottom="20dp" />

    <!-- Botón para realizar la suma -->
    <Button
        android:id="@+id/btnSum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sumar 5 + 3"
        android:layout_marginBottom="10dp"/>

    <!-- Botón para realizar la resta -->
    <Button
        android:id="@+id/btnSubtract"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Restar 5 - 3"
        android:layout_marginBottom="10dp"/>

    <!-- Botón para realizar la multiplicación -->
    <Button
        android:id="@+id/btnMultiply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Multiplicar 5 * 3"
        android:layout_marginBottom="20dp"/>

    <!-- TextView para mostrar el resultado -->
    <TextView
        android:id="@+id/resultText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resultado: "
        android:textSize="18sp"
        android:textColor="@android:color/black"/>
</LinearLayout>
